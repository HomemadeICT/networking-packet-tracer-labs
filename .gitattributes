# Mark Cisco Packet Tracer files as binary so git never tries to diff/merge them as text
*.pkt  binary
*.pkt~ binary

# Mark PDF files as binary
*.pdf  binary

# Ensure images are treated as binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  binary

# Ensure consistent line endings for text files on all platforms
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
